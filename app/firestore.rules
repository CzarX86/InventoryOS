rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Access claims are written only by Cloud Functions/Admin SDK.
    function isApprovedMember() {
      return isSignedIn() && request.auth.token.accessApproved == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.accessAdmin == true;
    }

    function workspaceId() {
      return request.auth.token.workspaceId;
    }

    function recordWorkspace(data) {
      return data.workspaceId == null ? data.accountId : data.workspaceId;
    }

    function sameWorkspace(data) {
      return isApprovedMember() && recordWorkspace(data) == workspaceId();
    }

    function canCreateSharedResource() {
      return sameWorkspace(request.resource.data) &&
        request.resource.data.ownerId == request.auth.uid;
    }

    function canReadSharedResource() {
      return sameWorkspace(resource.data);
    }

    function canWriteSharedResource() {
      return sameWorkspace(resource.data) &&
        sameWorkspace(request.resource.data) &&
        request.resource.data.ownerId == resource.data.ownerId;
    }

    function canEscalateOwnError() {
      return isApprovedMember() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "reportedByUser",
          "reportedAt",
          "ticketId",
          "updatedAt"
        ]);
    }

    match /users/{userId} {
      // Profiles and access state are server-owned. A user can only read
      // their own profile and update harmless preferences.
      allow read: if isSignedIn() && userId == request.auth.uid;
      allow update: if isSignedIn() && userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "aiWorkflow",
          "displayName",
          "photoURL"
        ]);
      allow create, delete: if false;
    }

    match /in_app_notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUserId == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.recipientUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      allow create, delete: if false;
    }

    match /inventory/{itemId} {
      allow read, write: if isApprovedMember();
    }

    match /telemetry/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system/{docId} {
      allow read: if docId != "access_control" && (isAdmin() || (isApprovedMember() && docId == "feature_flags"));
      allow write: if false;
    }

    match /system/access_control {
      allow read, write: if false;
    }

    // FinOps summaries are server-owned. Only administrators can see the
    // measured/estimated ledger and the optional official Billing Export data.
    match /system_usage/{summaryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system_billing_reconciliation/{monthKey} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /usage_stats/{userId} {
      allow read: if isAdmin() || (isApprovedMember() && request.auth.uid == userId);
      allow create, update: if isApprovedMember() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /task_ai_usage/{taskId} {
      allow create: if isApprovedMember() && request.resource.data.actorId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /ai_runs/{runId} {
      allow create: if canCreateSharedResource();
      allow read, update, delete: if isAdmin() || canReadSharedResource();
    }

    match /ai_cost_policies/{policyId} {
      allow create: if canCreateSharedResource();
      allow read, update, delete: if isAdmin() || canReadSharedResource();
    }

    match /prompt_templates/{templateId} {
      allow create: if canCreateSharedResource();
      allow read, update, delete: if isAdmin() || canReadSharedResource();
    }

    match /style_profiles/{profileId} {
      allow create: if canCreateSharedResource();
      allow read, update, delete: if isAdmin() || canReadSharedResource();
    }

    // Raw WhatsApp data and instance control remain administrative surfaces.
    match /whatsapp_instances/{instanceId} {
      allow read, write: if isAdmin();
    }

    match /whatsapp_webhook_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsapp_messages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsapp_extracted_transactions/{transactionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /whatsapp_contacts/{contactId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /whatsapp_groups/{groupId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /history_backfill_jobs/{jobId} {
      allow create: if canCreateSharedResource();
      allow read, update, delete: if isAdmin() || canReadSharedResource();
    }

    match /txt_import_jobs/{jobId} {
      allow create: if canCreateSharedResource();
      allow read, update, delete: if isAdmin() || canReadSharedResource();
    }

    match /crm_import_jobs/{jobId} {
      // The original file and all state transitions are controlled by
      // Cloud Functions; approved workspace members can only inspect the
      // scoped status and validation preview.
      allow read: if isAdmin() || canReadSharedResource();
      allow create, update, delete: if false;
    }

    match /message_dispatch_jobs/{jobId} {
      allow create: if canCreateSharedResource();
      allow read, update, delete: if isAdmin() || canReadSharedResource();
    }

    match /activity_log/{eventId} {
      allow create: if isApprovedMember() && request.resource.data.actorId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /error_reports/{errorId} {
      allow create: if isApprovedMember() && request.resource.data.userId == request.auth.uid;
      allow update: if canEscalateOwnError() || isAdmin();
      allow read, delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if isApprovedMember() &&
        request.resource.data.createdByUserId == request.auth.uid &&
        get(/databases/$(database)/documents/error_reports/$(request.resource.data.errorId)).data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /module_requests/{requestId} {
      allow create: if isApprovedMember() &&
        request.resource.data.requesterUserId == request.auth.uid &&
        request.resource.data.workspaceId == workspaceId() &&
        request.resource.data.module == "whatsapp";
      allow read: if isAdmin() ||
        (isApprovedMember() && requestId == request.auth.uid + "_whatsapp");
      allow update: if isAdmin() ||
        (isApprovedMember() && resource.data.requesterUserId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["message", "updatedAt"]));
      allow delete: if isAdmin();
    }

    match /admin_device_tokens/{tokenId} {
      allow create, update: if isAdmin() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
    }

    // Expansion Track resources use accountId as a legacy workspace alias;
    // new records carry workspaceId and companyId independently.
    match /accounts/{accountId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /contact_channels/{channelId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /conversations/{conversationId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /messages/{messageId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /opportunities/{opportunityId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /contracts/{contractId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /crm_events/{eventId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /tasks/{taskId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /crm_review_items/{reviewId} {
      // Suggestions are created and resolved by Cloud Functions so the
      // approval trail cannot be bypassed with a client-side write.
      allow read: if isAdmin() || canReadSharedResource();
      allow create, update, delete: if false;
    }

    match /interests/{interestId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /catalog_items/{itemId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /inventory_items/{itemId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /installed_base/{itemId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /maintenance_rules/{ruleId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /item_relationships/{relationshipId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /supplier_accounts/{supplierId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /supplier_contacts/{contactId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /quote_requests/{requestId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /quote_responses/{responseId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /ai_usage_stats/{statsId} {
      allow read: if isAdmin() || canReadSharedResource();
      allow create, update: if canCreateSharedResource();
      allow delete: if isAdmin();
    }

    match /supplier_performance_profiles/{profileId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }

    match /procurement_opportunities/{opportunityId} {
      allow create: if canCreateSharedResource();
      allow read: if canReadSharedResource();
      allow update, delete: if canWriteSharedResource() || isAdmin();
    }
  }
}
